<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/publicTransportRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/transportHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/navigo_teal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnTransportBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Route Details"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvTransportHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Public Transport Details"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/transportScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/transportHeader"
        app:layout_constraintBottom_toTopOf="@id/btnSelectTransportRoute"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTransportMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bus"
                android:textColor="@color/navigo_navy"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTransportJourney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Starting point → Destination"
                android:textColor="@color/navigo_muted"
                android:textSize="14sp" />

            <!-- Transport service card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_home_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvTransportService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bus service"
                    android:textColor="@color/navigo_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransportArrival"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Arrival time: Not available yet"
                    android:textColor="@color/navigo_teal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTransportBoarding"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Boarding stop: Not available yet"
                    android:textColor="@color/navigo_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Service number, fare and timetable require live transit data."
                    android:textColor="@color/navigo_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:text="Journey"
                android:textColor="@color/navigo_teal"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Journey steps card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_home_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvTransportStepOne"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Walk to your boarding stop"
                    android:textColor="@color/navigo_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:paddingStart="5dp"
                    android:text="│"
                    android:textColor="@color/navigo_teal"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvTransportStepTwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Board the bus"
                    android:textColor="@color/navigo_text"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:paddingStart="5dp"
                    android:text="│"
                    android:textColor="@color/navigo_teal"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvTransportStepThree"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="● Arrive near your destination"
                    android:textColor="@color/navigo_text"
                    android:textSize="15sp" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <!-- Select route button -->
    <Button
        android:id="@+id/btnSelectTransportRoute"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/navigo_teal"
        android:text="Select This Route"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>