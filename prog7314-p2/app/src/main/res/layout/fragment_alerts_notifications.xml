<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/alertsHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/navigo_teal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Alerts / Notifications"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearAlerts"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:text="Clear"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Clear demo alerts" />

    </LinearLayout>

    <!-- Demo notice -->
    <TextView
        android:id="@+id/tvAlertsDemoNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#E7F4F2"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:text="Demo alerts only • Not live updates"
        android:textColor="@color/navigo_navy"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/alertsHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/alertsFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvAlertsDemoNotice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="95dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterWeather"
                android:layout_width="95dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="Weather"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterTransit"
                android:layout_width="95dp"
                android:layout_height="50dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="Transit"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnFilterIncidents"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_marginTop="2dp"
            android:backgroundTint="@color/navigo_teal"
            android:text="Incidents"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>


    <Button
        android:id="@+id/btnReportIncident"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/navigo_blue"
        android:text="Report an Incident"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/alertsFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- Alert cards -->
    <ScrollView
        android:id="@+id/alertsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnReportIncident"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/alertsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvAlertsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No demo alerts to display."
                android:textColor="@color/navigo_muted"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>