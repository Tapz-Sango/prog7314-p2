<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background"
    tools:context=".HomeActivity">

    <com.google.android.gms.maps.MapView
        android:id="@+id/homeMap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_home_card"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/navigo_navy"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/tvSearchDestination"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:hint="Where would you like to go?"
            android:textColor="@color/navigo_text"
            android:textColorHint="@color/navigo_muted"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnMyLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Show my location"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/navigo_blue"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

    <!-- Map tip -->
    <TextView
        android:id="@+id/tvMapTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home_card"
        android:elevation="3dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="Long-press the map to select a destination"
        android:textColor="@color/navigo_navy"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="@id/searchBar" />


    <!-- Bottom map information -->
    <LinearLayout
        android:id="@+id/conditionsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_home_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSelectedPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore your surroundings"
            android:textColor="@color/navigo_navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap or long-press a place on the map"
            android:textColor="@color/navigo_muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/navigo_light_grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWeatherSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☁ Weather: not connected"
                android:textColor="@color/navigo_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvIncidentSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="⚠ Reports: not connected"
                android:textColor="@color/navigo_muted"
                android:textSize="11sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnPlanRoute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/navigo_teal"
            android:enabled="false"
            android:text="Choose a destination on the map"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@android:color/white"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navHome"
            style="@style/NaviGoBottomItem"
            android:text="⌂&#10;Home"
            android:textColor="@color/navigo_teal" />

        <TextView
            android:id="@+id/navAlerts"
            style="@style/NaviGoBottomItem"
            android:text="⚠&#10;Alerts" />

        <TextView
            android:id="@+id/navTrips"
            style="@style/NaviGoBottomItem"
            android:text="▤&#10;Trips" />

        <TextView
            android:id="@+id/navSettings"
            style="@style/NaviGoBottomItem"
            android:text="⚙&#10;Settings" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>