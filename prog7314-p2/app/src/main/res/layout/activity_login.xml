<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/loginTopGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.19" />

    <LinearLayout
        android:id="@+id/loginContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/loginTopGuide">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome back!"
            android:textColor="@color/navigo_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Sign in to unlock and continue your journey"
            android:textColor="@color/navigo_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="46dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_auth_tabs"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_white_tab"
                android:gravity="center"
                android:text="Login"
                android:textColor="@color/navigo_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Register"
                android:textColor="@color/navigo_muted"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnLoginSSO"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="70dp"
            android:backgroundTint="@color/navigo_teal"
            android:text="Sign in with SSO"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- Test button -->
        <Button
            android:id="@+id/btnDevPreview"
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Test Login"
            android:textAllCaps="false"
            android:backgroundTint="@color/navigo_navy"
            android:textColor="@android:color/white"
            android:visibility="gone"
            tools:visibility="visible" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="OR"
            android:textColor="@color/navigo_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnBiometrics"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/navigo_blue"
            android:enabled="false"
            android:text="Use Biometrics (Final POE)"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textColor="@color/navigo_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRegisterLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register"
                android:textColor="@color/navigo_teal"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvLoginLegal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="By continuing, you agree to our Terms &amp; Privacy"
        android:textColor="@color/navigo_muted"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>