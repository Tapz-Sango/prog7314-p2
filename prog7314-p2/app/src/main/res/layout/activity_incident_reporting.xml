<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incidentReportingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/incidentHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/navigo_teal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnIncidentBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Alerts"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report an incident"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Form -->
    <ScrollView
        android:id="@+id/incidentFormScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/incidentHeader"
        app:layout_constraintBottom_toTopOf="@id/incidentBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="What happened?"
                android:textColor="@color/navigo_navy"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgIncidentTypes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbIncidentAccident"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/navigo_teal"
                    android:gravity="center_vertical"
                    android:text="Accident"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbIncidentRoadBlockage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/navigo_teal"
                    android:gravity="center_vertical"
                    android:text="Road blockage"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbIncidentTraffic"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/navigo_teal"
                    android:gravity="center_vertical"
                    android:text="Traffic"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbIncidentRoadHazard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/navigo_teal"
                    android:gravity="center_vertical"
                    android:text="Road hazard"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Location"
                android:textColor="@color/navigo_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnIncidentLocation"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="◎ Current Location"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvIncidentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Location not selected (optional)"
                android:textColor="@color/navigo_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Write a short description"
                android:textColor="@color/navigo_navy"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etIncidentDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_home_card"
                android:gravity="top|start"
                android:hint="Describe what happened..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/navigo_navy"
                android:textColorHint="@color/navigo_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSubmitIncident"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Demo form only. Reports are not sent to other users yet."
                android:textColor="@color/navigo_muted"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/incidentBottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navIncidentHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Home"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="@color/navigo_navy"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@color/navigo_navy"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navIncidentAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Alerts"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♟"
                android:textColor="@color/navigo_teal"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts"
                android:textColor="@color/navigo_teal"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navIncidentTrips"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Trips"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚌"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trips"
                android:textColor="@color/navigo_navy"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navIncidentSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textColor="@color/navigo_navy"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/navigo_navy"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>