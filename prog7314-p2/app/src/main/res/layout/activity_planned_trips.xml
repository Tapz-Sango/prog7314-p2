<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/plannedTripsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navigo_background"
    tools:context=".PlannedTripsActivity">

    <TextView
        android:id="@+id/tripsHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/navigo_teal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:text="Your Trips"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tripsHeader"
        app:layout_constraintBottom_toTopOf="@id/tripsBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Upcoming"
                android:textColor="@color/navigo_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlanNewTrip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="@color/navigo_teal"
                android:text="+ Plan New Trip"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />

            <!-- Expands on the same screen -->
            <LinearLayout
                android:id="@+id/tripForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan a new trip"
                    android:textColor="@color/navigo_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTripName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Trip name (e.g. University)"
                    android:inputType="textCapSentences"
                    android:maxLength="60"
                    android:singleLine="true"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etTripDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Destination"
                    android:inputType="textCapWords"
                    android:maxLength="100"
                    android:singleLine="true"
                    android:textColor="@color/navigo_navy"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Transport mode"
                    android:textColor="@color/navigo_navy"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerTripMode"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTripDate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Choose date"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btnTripTime"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Choose time"
                        android:textAllCaps="false" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancelTrip"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Cancel"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btnAddTrip"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/navigo_teal"
                        android:text="Add Trip"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTripsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="No trips planned yet. Tap + Plan New Trip to add one."
                android:textColor="@color/navigo_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/tripsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/tripsBottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navTripsHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Home"
            android:textColor="@color/navigo_navy"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navTripsAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♧&#10;Alerts"
            android:textColor="@color/navigo_navy"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/navTripsCurrent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚌&#10;Trips"
            android:textColor="@color/navigo_teal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navTripsSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙&#10;Settings"
            android:textColor="@color/navigo_navy"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>